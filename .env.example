# Server port
PORT=3000

# MongoDB (Docker container on localhost:27017)
MONGODB_URI=mongodb://127.0.0.1:27017/foliorag

# ChromaDB Vector Store (Docker container on localhost:8000)
CHROMA_URL=http://127.0.0.1:8000
CHROMA_COLLECTION=folio_pdf_chunks

# Local Ollama AI Runtime (default local LLM & embeddings)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional Cloud Providers (configure in .env locally or Settings > Secrets)
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
